rules_version = '2';

// Genlingo audience app — Firestore database `genlingo`.
//
// Writes: NONE from clients. Phones write through the API routes (Admin SDK), which enforce
// the 20 s rate limit in a transaction (rateLimits/{uid}), validate the input, apply the
// blocklist and keep one vote per person. Denying client writes here means none of that can be
// skipped by calling Firestore directly with the web SDK.
//
// Reads: what a phone needs in real time (the round on screen), and each person's own
// submissions. The presenter (email auth, custom claim admin=true) reads the review queues.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function owns(data) { return signedIn() && data.uid == request.auth.uid; }

    match /rounds/{roundId} {
      allow read: if signedIn();
      allow write: if false;

      match /votes/{uid} {
        // You can see your own vote (to show "ya votaste"); tallies are read by the duel service.
        allow read: if isAdmin() || (signedIn() && uid == request.auth.uid);
        allow write: if false;
      }
    }

    match /phrases/{id} {
      allow read: if isAdmin() || owns(resource.data);
      allow write: if false;
    }

    match /pairs/{id} {
      allow read: if isAdmin() || owns(resource.data);
      allow write: if false;
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
