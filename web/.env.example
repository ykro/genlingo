# Audience web app (Next.js on Cloud Run). ADC for the Admin SDK.
GOOGLE_CLOUD_PROJECT=ai-experiments-487722
FIRESTORE_DATABASE=genlingo
EVENT_ID=ensayo
# Presenter accounts (email sign-in) allowed to use /admin and /api/admin/*.
ADMIN_EMAILS=
# 1 = require a valid App Check token (X-Firebase-AppCheck header) on audience requests.
APP_CHECK_ENFORCE=0
# Public Firebase web config (Firebase console > Project settings > Your apps > "Genlingo audiencia").
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=ai-experiments-487722.firebaseapp.com
FIREBASE_APP_ID=
# Country variant used for the audience's pairs and the presenter's typed phrases (MX, GT, CO, LATAM).
EVENT_COUNTRY=GT
# Public URL of this app (shown as a QR code on the presenter view).
AUDIENCE_URL=
# Duel service on the stage laptop (used by /presenter only).
DUEL_URL=http://127.0.0.1:8787
# reCAPTCHA Enterprise site key used by App Check (infra/06-app-check.sh). Empty = App Check off.
RECAPTCHA_SITE_KEY=
# Rehearsals only: the App Check debug token printed by infra/06-app-check.sh. Playwright puts it in
# the browser; on an emulator open <url>#appcheck-debug=<token> once. Never deploy it.
APPCHECK_DEBUG_TOKEN=
# 1 (default) = phrases that pass the blocklist go straight to the stage queue; 0 = the presenter approves them in /admin.
AUTO_APPROVE_PHRASES=1
