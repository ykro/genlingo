# ---- Google Cloud (ADC: `gcloud auth application-default login`) --------------------------
GOOGLE_CLOUD_PROJECT=ai-experiments-487722
GOOGLE_CLOUD_LOCATION=global

# ---- Goliath: Gemini on Vertex AI ---------------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.x reasoning level; "low" keeps a one-line translation fast (this model has no "minimal").
GEMINI_THINKING_LEVEL=low
# USD per 1M tokens (standard tier), as a dated schedule: DATE:INPUT/OUTPUT, comma separated.
# The duel and the eval use the price in force on their date and record which one they used.
# Thinking tokens are billed as output. Checked 2026-09-30: 0.75/3.75 until 2026-12-31, then the
# list price doubles to 1.50/7.50 from 2027-01-01.
GEMINI_PRICE_SCHEDULE=2026-09-30:0.75/3.75,2027-01-01:1.50/7.50

# ---- David: fine-tuned Gemma served by Ollama on the laptop ---------------------------------
OLLAMA_URL=http://127.0.0.1:11434
# Ollama tag of the current David (chosen by `make eval`: most slang handled with p50 < 1 s).
# Tags carry the data date: genlingo-YYYY-MM[-base]; -f16 is the unquantized export.
LOCAL_MODEL_TAG=genlingo-2026-10-e2b-f16
# Last month's David, for the "last month vs this month" duel (key M on the presenter view).
DAVID_PREVIOUS_TAG=genlingo-2026-09
# Davids compared in `make eval` (each with the prompt he was trained on).
DAVID_TAGS=genlingo-2026-10-e2b,genlingo-2026-10-e4b,genlingo-2026-09
# Local embedding model (Ollama) used to retrieve the term-bank glossary for David's prompt.
EMBEDDING_MODEL=embeddinggemma
# Base (not fine-tuned) Ollama models compared in `make eval` (E2B vs E4B).
BASE_MODEL_TAGS=gemma4:e2b-it-qat,gemma4:e4b

# ---- Training (Cloud Run Job, 1x NVIDIA L4, europe-west4) -----------------------------------
# cloud-run (default): serverless GPU job, billed per second, same container as everything else.
# vertex: the same container as a Vertex AI Custom Job (uses TRAIN_MACHINE / TRAIN_ACCELERATOR /
# TRAIN_SCHEDULING / TRAIN_HOURLY_USD below).
TRAIN_RUNTIME=cloud-run
TRAIN_REGION=europe-west4
# Checkpoint name of the base model to fine-tune (Hugging Face format).
GEMMA_BASE_MODEL=gemma-4-E2B-it
# Where the weights are read from. hf://google = Hugging Face (Gemma 4 is Apache 2.0, not gated);
# the job reads HF_TOKEN from Secret Manager secret `hf-token` if it exists (avoids 429s on
# anonymous downloads from cloud IPs), else downloads anonymously.
# Alternative with no Hugging Face at all: gs://vertex-model-garden-public-us/gemma4 (public bucket).
GEMMA_WEIGHTS_URI=hf://google
# Ollama RENDERER/PARSER of the base model family (the one in the base model's Modelfile): the
# fine-tuned GGUF is prompted exactly like its base.
OLLAMA_RENDERER=gemma4
# Cloud Run Job prices (USD/second, L4 without zonal redundancy); used for the run's cost.
CLOUD_RUN_L4_USD_PER_S=0.0001867
CLOUD_RUN_VCPU_USD_PER_S=0.000018
CLOUD_RUN_GIB_USD_PER_S=0.000002
# Vertex AI alternative only.
TRAIN_MACHINE=g2-standard-8
TRAIN_ACCELERATOR=NVIDIA_L4
TRAIN_SCHEDULING=STANDARD
TRAIN_HOURLY_USD=1.10
MODELS_BUCKET=gs://ai-experiments-487722-genlingo-models
STAGING_BUCKET=gs://ai-experiments-487722-train-eu

# ---- Duel service ---------------------------------------------------------------------------
DUEL_PORT=8787
DUEL_DB_PATH=duel/state/genlingo.sqlite
# 1 = no network, no GPU: deterministic mock models (tests, rehearsals).
MOCK_AI=0
# 1 = simulate "Wi-Fi off" for Goliath without touching the OS.
FORCE_OFFLINE=0
# Evaluation rounds may use test pairs not yet reviewed by the presenter (0 on stage).
ALLOW_UNREVIEWED_TEST=0

# ---- Audience (Firestore) -------------------------------------------------------------------
FIRESTORE_DATABASE=genlingo
# Event id: scopes phrases/rounds/votes and is the provenance of human pairs.
EVENT_ID=ensayo
# 1 = the duel service listens to Firestore for presenter-approved audience phrases.
AUDIENCE_FEED=0

# ---- Data generation ------------------------------------------------------------------------
SYNTHETIC_PAIRS_TARGET=1500
