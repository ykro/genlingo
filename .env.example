# ---- Google Cloud (ADC: `gcloud auth application-default login`) --------------------------
GOOGLE_CLOUD_PROJECT=ai-experiments-487722
GOOGLE_CLOUD_LOCATION=global

# ---- Goliath: Gemini on Vertex AI ---------------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.x reasoning level; "low" keeps a one-line translation fast (this model has no "minimal").
GEMINI_THINKING_LEVEL=low
# USD per 1M tokens (standard tier). Thinking tokens are billed as output.
# Until 2026-12-31: 0.75 / 3.75. From 2027-01-01 the list price doubles: 1.50 / 7.50.
GEMINI_INPUT_USD_PER_M=0.75
GEMINI_OUTPUT_USD_PER_M=3.75

# ---- David: fine-tuned Gemma served by Ollama on the laptop ---------------------------------
OLLAMA_URL=http://127.0.0.1:11434
# Ollama tag of the current David. Tags carry the data date: genlingo-YYYY-MM.
LOCAL_MODEL_TAG=genlingo-2026-09
# Base (not fine-tuned) Ollama models compared in `make eval` (E2B vs E4B).
BASE_MODEL_TAGS=gemma4:e2b-it-qat,gemma4:e4b

# ---- Training (Vertex AI Custom Job, L4, europe-west4) --------------------------------------
# Checkpoint name of the base model to fine-tune (Hugging Face format).
GEMMA_BASE_MODEL=gemma-4-E2B-it
# Where the weights are read from. hf://google = Hugging Face (Gemma 4 is Apache 2.0, not gated);
# the job reads HF_TOKEN from Secret Manager secret `hf-token` if it exists (avoids 429s on
# anonymous downloads from cloud IPs), else downloads anonymously.
# Alternative with no Hugging Face at all: gs://vertex-model-garden-public-us/gemma4 (public bucket).
GEMMA_WEIGHTS_URI=hf://google
TRAIN_REGION=europe-west4
TRAIN_MACHINE=g2-standard-8
TRAIN_ACCELERATOR=NVIDIA_L4
# STANDARD (on-demand) or SPOT (preemptible quota, cheaper). Vertex custom training GPU quota is
# separate from Compute Engine: request L4 with infra/03-request-training-gpu-quota.sh. Until it is
# granted, this project has Spot A100 quota in europe-west4:
#   TRAIN_MACHINE=a2-highgpu-1g TRAIN_ACCELERATOR=NVIDIA_TESLA_A100 TRAIN_SCHEDULING=SPOT TRAIN_HOURLY_USD=2.80
TRAIN_SCHEDULING=STANDARD
# Estimated on-demand Vertex AI training price for the machine above (USD/hour), used to turn
# job duration into cost in train/runs/<tag>.json. Check the Vertex AI pricing page.
TRAIN_HOURLY_USD=1.10
MODELS_BUCKET=gs://ai-experiments-487722-genlingo-models
STAGING_BUCKET=gs://ai-experiments-487722-train-eu

# ---- Duel service ---------------------------------------------------------------------------
DUEL_PORT=8787
DUEL_DB_PATH=duel/state/genlingo.sqlite
# 1 = no network, no GPU: deterministic mock models (tests, rehearsals).
MOCK_AI=0
# 1 = simulate "Wi-Fi off" for Goliath without touching the OS.
FORCE_OFFLINE=0
# Evaluation rounds may use test pairs not yet reviewed by the presenter (0 on stage).
ALLOW_UNREVIEWED_TEST=0

# ---- Audience (Firestore) -------------------------------------------------------------------
FIRESTORE_DATABASE=genlingo
# Event id: scopes phrases/rounds/votes and is the provenance of human pairs.
EVENT_ID=ensayo
# 1 = the duel service listens to Firestore for presenter-approved audience phrases.
AUDIENCE_FEED=0

# ---- Data generation ------------------------------------------------------------------------
SYNTHETIC_PAIRS_TARGET=1000
