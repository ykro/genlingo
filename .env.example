# ---- Google Cloud (ADC: `gcloud auth application-default login`) --------------------------
GOOGLE_CLOUD_PROJECT=ai-experiments-487722
GOOGLE_CLOUD_LOCATION=global

# ---- Goliath: Gemini on Vertex AI ---------------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.x reasoning level; "low" keeps a one-line translation fast (this model has no "minimal").
GEMINI_THINKING_LEVEL=low
# USD per 1M tokens (standard tier), as a dated schedule: DATE:INPUT/OUTPUT, comma separated.
# The duel and the eval use the price in force on their date and record which one they used.
# Thinking tokens are billed as output. Checked 2026-09-30: 0.75/3.75 until 2026-12-31, then the
# list price doubles to 1.50/7.50 from 2027-01-01.
GEMINI_PRICE_SCHEDULE=2026-09-30:0.75/3.75,2027-01-01:1.50/7.50

# ---- David: fine-tuned Gemma served by Ollama on a Cloud Run GPU (infra/04-david.sh) -----------
# Ollama tag of David, the one the page uses, chosen by `make eval`: the smallest export within 2 points of
# its f16 on slang handled, with p50 < 1 s (see the Compresión section of evals/report.md).
# Tags carry the data date: genlingo-YYYY-MM[-base]; -f16 is the unquantized export. make train
# publishes QUANT (Q5_K_M) under the plain tag: genlingo-2026-10d-e2b is Q5_K_M. Round 4 (2026-10-06, Gen Z of
# Mexico and neutral Spanish) replaced genlingo-2026-10c-e2b-nomulti; round 5 (2026-10-07, sentences that combine several
# slang terms) chose genlingo-2026-10e-e2b on dev (56.5 % vs 34.8 % jerga correcta on dev combinations); to put it on
# the page: DAVID_MODEL_TAG=genlingo-2026-10e-e2b and `make deploy`.
DAVID_MODEL_TAG=genlingo-2026-10e-e2b
# David's private service (infra/05-page.sh reads it from Cloud Run when it deploys the page; data scripts
# that embed with David's embedding model, e.g. `make train-data`, use this one).
DAVID_URL=https://genlingo-david-611681112050.europe-west4.run.app
# Region of David's GPU service (L4 quota) and of the eval job.
DAVID_REGION=europe-west4
# Size of David's GPU service (infra/04-david.sh): 1 NVIDIA L4 + these vCPUs and GiB. The page prices each of
# David's translations as its seconds × (L4 + DAVID_CPU × vCPU + DAVID_MEMORY_GIB × GiB) per-second prices below.
DAVID_CPU=4
DAVID_MEMORY_GIB=16
# Davids compared in `make eval` (each with the prompt he was trained on).
DAVID_TAGS=genlingo-2026-10e-e2b,genlingo-2026-10d-e2b,genlingo-2026-10c-e2b-nomulti,genlingo-2026-10b-e2b,genlingo-2026-10-e2b-q5_k_m,genlingo-2026-10-e2b,genlingo-2026-09
# Embedding model (Ollama, on David's service) used to retrieve the term-bank glossary for David's prompt.
# Version 1 on purpose: version 2 measured worse in Tzij and doesn't run on Ollama with CUDA yet (docs/DECISIONES.md, "EmbeddingGemma").
EMBEDDING_MODEL=embeddinggemma
# Base (not fine-tuned) Ollama models compared in `make eval` (E2B vs E4B).
BASE_MODEL_TAGS=gemma4:e2b-it-qat,gemma4:e4b

# ---- Training (Cloud Run Jobs in europe-west4: 1x NVIDIA L4 trains, CPU job merges + GGUF) ----
# cloud-run (default): two serverless jobs, billed per second, same container as everything else.
# vertex: the same container as one Vertex AI Custom Job (uses TRAIN_MACHINE / TRAIN_ACCELERATOR /
# TRAIN_SCHEDULING / TRAIN_HOURLY_USD below).
TRAIN_RUNTIME=cloud-run
TRAIN_REGION=europe-west4
# Checkpoint name of the base model to fine-tune (Hugging Face format).
GEMMA_BASE_MODEL=gemma-4-E2B-it
# Where the weights are read from. hf://google = Hugging Face (Gemma 4 is Apache 2.0, not gated);
# the job reads HF_TOKEN from Secret Manager secret `hf-token` if it exists (avoids 429s on
# anonymous downloads from cloud IPs), else downloads anonymously.
# Alternative with no Hugging Face at all: gs://vertex-model-garden-public-us/gemma4 (public bucket).
GEMMA_WEIGHTS_URI=hf://google
# Ollama RENDERER/PARSER of the base model family (the one in the base model's Modelfile): the
# fine-tuned GGUF is prompted exactly like its base.
OLLAMA_RENDERER=gemma4
# Quantization of the published GGUF (the quant sweep's pick: smallest within 2 points of f16) and
# whether the f16 reference is published too (for the compression eval).
QUANT=Q5_K_M
KEEP_F16=1
# Cloud Run prices (USD/second, L4 without zonal redundancy, europe-west4): the training runs' cost and David's
# cost per translation on the page.
CLOUD_RUN_L4_USD_PER_S=0.0001867
CLOUD_RUN_VCPU_USD_PER_S=0.000018
CLOUD_RUN_GIB_USD_PER_S=0.000002
# Vertex AI alternative only.
TRAIN_MACHINE=g2-standard-8
TRAIN_ACCELERATOR=NVIDIA_L4
TRAIN_SCHEDULING=STANDARD
TRAIN_HOURLY_USD=1.10
MODELS_BUCKET=gs://ai-experiments-487722-genlingo-models
STAGING_BUCKET=gs://ai-experiments-487722-train-eu
# Private bucket with the verbatim sentences of sources that don't allow redistribution (make data-pull).
PRIVATE_DATA_URI=gs://ai-experiments-487722-genlingo-private

# ---- The comparison page ------------------------------------------------------------------
# 1 = no network, no GPU: deterministic mock models (tests).
# Spending limits of the public page (duel/genlingo_duel/limits.py): per connection per minute, and per day.
LIMIT_TRANSLATE_PER_MIN=60
LIMIT_WAKE_PER_MIN=12
LIMIT_GEMINI_PER_DAY=1500
LIMIT_WAKES_PER_DAY=24
MOCK_AI=0
# The page translates with this country's slang (its examples are Guatemalan).
EVENT_COUNTRY=GT
# David's N-best: N answers in parallel (OLLAMA_NUM_PARALLEL), reranked with the term bank. 1 = off.
DAVID_NBEST=1

# ---- Data generation ------------------------------------------------------------------------
SYNTHETIC_PAIRS_TARGET=1500
